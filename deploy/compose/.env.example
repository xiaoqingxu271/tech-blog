# docker compose 用的环境变量（与 .env 分开，放 deploy/compose/.env，
# 启动时: docker compose --env-file deploy/compose/.env up -d）
POSTGRES_PASSWORD=<随机强密码>
NEXTAUTH_SECRET=<openssl rand -base64 32>
NEXTAUTH_URL=https://blog.yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<首次 seed 用，跑完删>
ADMIN_NAME=Admin
