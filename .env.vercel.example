# ============================================================
# Vercel 环境变量模板
# 用法：Project → Settings → Environment Variables 逐条添加，
# 三条 Production / Preview / Development 都要加（NEXTAUTH_URL 除外）。
# 千万不要把真实值提交进 git。
# ============================================================

# --- 数据库：连接 Vercel Postgres（Neon）---
# 在 Storage 里创建 Postgres 后，Vercel 自动注入 POSTGRES_URL 等一组变量。
# 这里把它转交给 Prisma 读取的 DATABASE_URL，值为：$POSTGRES_URL
DATABASE_URL=$POSTGRES_URL

# --- 认证 ---
# 生成：openssl rand -base64 32   （或 PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})）
NEXTAUTH_SECRET=<随机 32 字节 base64>

# 仅 Production 填正式域名，Preview 留空由 Vercel 自动推断
NEXTAUTH_URL=https://blog.yourdomain.com

# --- 图片存储：Vercel Blob（上传接口必须走对象存储，Serverless 文件系统只读）---
# 在 Storage 里创建 Blob Store 后，Vercel 自动注入此变量，本地开发从
# Vercel 控制台复制同值填入项目根 .env
BLOB_READ_WRITE_TOKEN=<vercel_blob_rw_...>

# --- 初始管理员（只在第一次跑 seed 时用，跑完建议删掉）---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<强密码>
ADMIN_NAME=Admin

# --- 可选：图片走外部图床时填 ---
# NEXT_PUBLIC_SITE_URL=https://blog.yourdomain.com
