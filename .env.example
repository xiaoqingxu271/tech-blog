# 数据库连接（PostgreSQL）。本地可用 Docker 起一个：
#   docker run -d --name blog-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=techblog -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techblog?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-in-production-please-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# 初始管理员账号（仅在首次 seed 时使用）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Admin"
